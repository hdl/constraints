# PCIe x1 link
set_property PACKAGE_PIN G4 [get_ports PicoEVB_PCIe_RXP]
set_property PACKAGE_PIN G3 [get_ports PicoEVB_PCIe_RXN]
set_property PACKAGE_PIN B2 [get_ports PicoEVB_PCIe_TXP]
set_property PACKAGE_PIN B1 [get_ports PicoEVB_PCIe_TXN]

# PCI Express Reference Clock: 100 MHz
set_property PACKAGE_PIN B6 [get_ports PicoEVB_Clock_PCIe_P]
set_property PACKAGE_PIN B5 [get_ports PicoEVB_Clock_PCIe_N]
create_clock -period 10.000 [get_ports PicoEVB_Clock_PCIe_P]

# Active low to request PCI Express Reference Clock
set_property PACKAGE_PIN A9 [get_ports PicoEVB_Clock_PCIe_CLKREQL]
set_property IOSTANDARD LVCMOS33 [get_ports PicoEVB_Clock_PCIe_CLKREQL]
set_property PULLDOWN true [get_ports PicoEVB_Clock_PCIe_CLKREQL]

# Reset generated by the PCI Express interface (PERST#).
set_property PACKAGE_PIN A10 [get_ports PicoEVB_PCIe_RSTN]
set_property IOSTANDARD LVCMOS33 [get_ports PicoEVB_PCIe_RSTN]
set_property PULLDOWN true [get_ports PicoEVB_PCIe_RSTN]
